<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".HugYourMugApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HugYourMug"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyC52p_bVitbYqxY6oP-u2QSOw11xXn3D7k" />

        <!-- LAUNCHER -->
        <activity
            android:name="com.example.hugyourmug.ui.auth.WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.HugYourMug">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AUTH -->
        <activity
            android:name="com.example.hugyourmug.ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name="com.example.hugyourmug.ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- MAIN APP -->
        <activity
            android:name="com.example.hugyourmug.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- MAPS -->
        <activity
            android:name="com.example.hugyourmug.ui.maps.MapsActivity"
            android:exported="false" />

    </application>

</manifest>
