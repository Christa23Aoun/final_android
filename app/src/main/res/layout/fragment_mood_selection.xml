<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How are you feeling today?"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/coffee_dark"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your current mood and let us suggest the perfect coffee ☕"
            android:textSize="16sp"
            android:textColor="@color/coffee_brown"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/moodHappy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="😊 Happy"
            android:backgroundTint="#F4A261"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/moodTired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="😴 Tired"
            android:backgroundTint="#6D6875"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/moodStudy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 Study Time"
            android:backgroundTint="#3A86FF"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/moodRelax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="😌 Relaxed"
            android:backgroundTint="#2A9D8F"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="14dp" />

    </LinearLayout>

</ScrollView>
