<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/coffee_cream"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtMoodTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coffee suggestions ☕"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/coffee_dark"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMoodSuggestions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnChangeMood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change mood ☕"
        android:backgroundTint="@color/coffee_brown"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnViewMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View full menu 📋"
        android:backgroundTint="@color/coffee_dark"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp" />

</LinearLayout>
